# persistent-vps configuration
# Copy to .env and fill in — the agent collects these values from the user
# during secrets intake (SECRETS.md). NEVER commit .env — this repo is public.
# There are NO default secrets in this file, by design.

# --- Cloud desktop gateway (GUIDE.md) ----------------------------------------
# HTTP Basic Auth for EVERY entry point of the desktop gateway.
# UTF-8 values; Arabic passwords are fully supported.
GATEWAY_USER=
GATEWAY_PASS=

# --- Tailscale ---------------------------------------------------------------

# Auth key (tskey-auth-...): registers THIS node on your tailnet. Required.
# Create one: https://login.tailscale.com/admin/settings/keys
# Prefer single-use, pre-authorized keys.
TAILSCALE_AUTH_KEY=

# API key (tskey-api-...): manages the tailnet via scripts/ts-api.sh. Optional.
# Create one: https://login.tailscale.com/admin/settings/keys (API access)
TAILSCALE_API_KEY=

# Your tailnet name, e.g. example.ts.net. Needed by scripts/ts-api.sh.
TAILNET_NAME=

# --- Node --------------------------------------------------------------------

# Stable hostname for this node in the tailnet.
VPS_HOSTNAME=persistent-vps

# Peer (tailnet IP or MagicDNS name) pinged by keep-alive to keep NAT mappings
# warm. Optional but recommended.
TAILSCALE_PEER=

# --- State -------------------------------------------------------------------

# Directory whose contents are snapshotted daily.
PERSIST_DIR=/srv/persistent

# Private git remote for state snapshots (branch: state). Leave empty for
# local-only snapshots at /var/lib/persistent-vps/state.git.
# WARNING: only use a PRIVATE remote — snapshots may contain sensitive data.
STATE_GIT_REMOTE=
