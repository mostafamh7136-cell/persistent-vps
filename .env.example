# persistent-vps — .env template
# Copy to .env and fill in. NEVER commit .env (gitignored).
# chmod 600 .env

# ── Tier 1 — REQUIRED (Mode A: Tailscale node) ─────────────────────────
# Reusable, pre-authorized, tagged, NON-ephemeral, <=90 days.
# Admin console -> Settings -> Keys -> Generate auth key.
# Single-use or ephemeral keys BREAK auto-re-join after a recycle.
TAILSCALE_AUTH_KEY=

# ── Non-secret configuration ───────────────────────────────────────────
# Agent derives <AgentName>-vps-<n> if unset.
VPS_HOSTNAME=
# Your tailnet name (needed only by scripts/ts-api.sh), e.g. example.ts.net
TAILNET_NAME=
# Peer hostname/IP pinged by keep-alive to keep NAT mappings warm
TAILSCALE_PEER=
# Directory snapshotted daily (default /srv/persistent)
PERSIST_DIR=
# Persistent state dir for tailscaled, kept across recycles
TAILSCALE_STATE_DIR=/var/lib/tailscale
# Optional: pin the Tailscale version for the installer (e.g. 1.80.0)
TAILSCALE_VERSION=

# ── Tier 2 — OPTIONAL (enable extras) ──────────────────────────────────
# tskey-api-... for the HTTP API (scripts/ts-api.sh). Rotate every <=90 days.
TAILSCALE_API_KEY=
# PRIVATE git remote for daily state snapshots (scripts/state-save.sh).
# Must be private; encrypt snapshots if they may contain sensitive material.
STATE_GIT_REMOTE=

# ── Tier 3 — Mode B only (graphical desktop) ───────────────────────────
# Basic Auth for the desktop gateway (desktop/server.py). UTF-8 (Arabic OK).
GATEWAY_USER=admin
GATEWAY_PASS=
